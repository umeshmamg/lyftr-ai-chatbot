# Ordered API key pool (key_1, key_2, ...) - configure at least 2 keys
LLM_API_KEYS=your-first-api-key,your-second-api-key

# Default LiteLLM model (and optional comma-separated per-key models)
LLM_MODEL=gemini/gemini-2.0-flash
LLM_MODELS=
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30.0

# SQLite storage path (Docker Compose mounts a persistent volume at /data)
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated CORS origins allowed by FastAPI
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable LiteLLM response caching and X-Simulate-Failure test hook
CACHE_ENABLED=true
ENABLE_FAILURE_SIMULATION=true

# Default assistant instructions
DEFAULT_SYSTEM_PROMPT="You are Lyftr AI, a helpful, concise, and knowledgeable assistant."
MAX_HISTORY_MESSAGES=40

# Optional frontend override for split deployments (leave empty for Vite/Nginx proxy)
VITE_API_BASE_URL=
